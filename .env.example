# Copy to .env.local and fill in.

# Password for /login (admin dashboard).
ADMIN_PASSWORD=change-me

# Signs the admin session cookie and salts visitor IP hashes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional - where the SQLite file lives. Defaults to ./data/portfolio.db
# On Railway set it to the volume path, e.g. /data/portfolio.db
# DATABASE_PATH=./data/portfolio.db
