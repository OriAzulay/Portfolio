# Copy to .env.local and fill in.

# Password for /login (admin dashboard).
ADMIN_PASSWORD=change-me

# Signs the admin session cookie and salts visitor IP hashes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Database. Leave these unset locally to use the SQLite file ./data/portfolio.db.
# In production (Vercel) the Turso integration sets them automatically.
# TURSO_DATABASE_URL=libsql://<your-db>.turso.io
# TURSO_AUTH_TOKEN=
# DATABASE_PATH=./data/portfolio.db   # optional: a different local file

# Optional - email me when someone uses the contact form (https://resend.com).
# Messages are always saved to the dashboard inbox either way.
# RESEND_API_KEY=
# CONTACT_NOTIFY_EMAIL=you@example.com   # defaults to the email on your profile
# RESEND_FROM=Portfolio <hello@your-domain.com>   # defaults to onboarding@resend.dev
