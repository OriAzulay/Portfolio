# Copy to .env.local and fill in.

# Password for /login (admin dashboard).
ADMIN_PASSWORD=change-me

# Signs the admin session cookie and salts visitor IP hashes.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional - where the SQLite file lives. Defaults to ./data/portfolio.db
# On Railway set it to the volume path, e.g. /data/portfolio.db
# DATABASE_PATH=./data/portfolio.db

# Optional - email me when someone uses the contact form (https://resend.com).
# Messages are always saved to the dashboard inbox either way.
# RESEND_API_KEY=
# CONTACT_NOTIFY_EMAIL=you@example.com   # defaults to the email on your profile
# RESEND_FROM=Portfolio <hello@your-domain.com>   # defaults to onboarding@resend.dev
